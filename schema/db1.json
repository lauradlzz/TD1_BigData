{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DB1",
  "type": "object",
  "properties": {
    "Product": {
      "type": "object",
      "properties": {
        "IDP": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "type": "object",
          "properties": {
            "amount": {
              "type": "number"
            },
            "currency": {
              "type": "string"
            },
            "vat": {
              "type": "integer"
            }
          },
          "required": [
            "amount",
            "currency",
            "vat"
          ]
        },
        "brand": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "format": "longstring"
        },
        "image_url": {
          "type": "string"
        },
        "Categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ]
          }
        },
        "Supplier": {
          "type": "object",
          "properties": {
            "IDS": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "SIRET": {
              "type": "string"
            },
            "headOffice": {
              "type": "string"
            },
            "Revenue": {
              "type": "integer"
            }
          },
          "required": [
            "IDS",
            "name",
            "SIRET",
            "headOffice",
            "Revenue"
          ]
        }
      },
      "required": [
        "IDP",
        "name",
        "price",
        "brand",
        "description",
        "image_url",
        "Categories",
        "Supplier"
      ]
    },
    "Stock": {
      "type": "object",
      "properties": {
        "IDP": {
          "type": "integer"
        },
        "IDW": {
          "type": "integer"
        },
        "quantity": {
          "type": "integer"
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "IDP",
        "IDW",
        "quantity",
        "location"
      ]
    },
    "Warehouse": {
      "type": "object",
      "properties": {
        "IDW": {
          "type": "integer"
        },
        "address": {
          "type": "string"
        },
        "capacity": {
          "type": "integer"
        }
      },
      "required": [
        "IDW",
        "address",
        "capacity"
      ]
    },
    "OrderLine": {
      "type": "object",
      "properties": {
        "IDC": {
          "type": "integer"
        },
        "IDP": {
          "type": "integer"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "quantity": {
          "type": "integer"
        },
        "deliveryDate": {
          "type": "string",
          "format": "date"
        },
        "comment": {
          "type": "string",
          "format": "longstring"
        },
        "grade": {
          "type": "integer"
        }
      },
      "required": [
        "IDC",
        "IDP",
        "date",
        "quantity",
        "deliveryDate",
        "comment",
        "grade"
      ]
    },
    "Client": {
      "type": "object",
      "properties": {
        "IDC": {
          "type": "integer"
        },
        "ln": {
          "type": "string"
        },
        "fn": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "nationality": {
          "type": "string"
        },
        "birthDate": {
          "type": "string",
          "format": "date"
        },
        "email": {
          "type": "string"
        }
      },
      "required": [
        "IDC",
        "ln",
        "fn",
        "address",
        "nationality",
        "birthDate",
        "email"
      ]
    }
  },
  "required": [
    "Product",
    "Stock",
    "Warehouse",
    "OrderLine",
    "Client"
  ]
}
